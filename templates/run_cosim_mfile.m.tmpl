% Auto-generated CarSim co-sim driver (.m controller)
% Generated by the CarSim MCP (scaffold_cosim). The @CONTROLLER_CALL@ statement
% must assign a variable named 'results' (struct or array) that we save below.
addpath('@SOLVER_DIR@');            % vs_sf.mexw64 and CarSim solver helpers
simfile = '@SIMFILE@';             %#ok<NASGU>  pass this to your controller as needed
stop_time = '@STOP@';              %#ok<NASGU>
% CarSim S-Functions (vs_sf/vs_ctl/vs_dyn) read the simfile by relative name, so
% run from the simfile's folder (the CarSim database working dir) -- same as the
% .slx driver. Harmless if your controller uses the absolute 'simfile' path.
sdir = fileparts(simfile);
if ~isempty(sdir), cd(sdir); end

@CONTROLLER_CALL@

if ~exist('results', 'var')
    error('co-sim driver: the controller call did not produce a variable named "results".');
end
save('@RESULTS@', 'results');
disp('COSIM_OK');
