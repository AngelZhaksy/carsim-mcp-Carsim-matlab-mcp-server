% Auto-generated CarSim co-sim driver (.slx / .mdl)
% Generated by the CarSim MCP (scaffold_cosim). Run via the MATLAB MCP
% (run_matlab_file) or, unattended, via carsim.run_cosim_headless.
addpath('@SOLVER_DIR@');            % vs_sf.mexw64 and CarSim solver helpers
simfile = '@SIMFILE@';             %#ok<NASGU>  consumed by the CarSim S-Function block
mdl = '@MODEL@';
[mdir, mname, ~] = fileparts(mdl);
if ~isempty(mdir), addpath(mdir); end
% CarSim S-Function blocks read the simfile by relative name (e.g. 'simfile.sim'),
% so run from the simfile's folder (the CarSim database working dir).
sdir = fileparts(simfile);
if ~isempty(sdir), cd(sdir); end
load_system(mdl);

% The CarSim S-Function block reads its simfile from the MATLAB variable
% 'simfile' (default wiring in CarSim's shipped example models). If your model
% hard-codes the simfile, that path is used instead.
so = sim(mname, 'StopTime', '@STOP@', 'ReturnWorkspaceOutputs', 'on'); %#ok<NASGU>

save('@RESULTS@', 'so');
disp('COSIM_OK');
